  "signed_binding": {
    "role": "admin",
    "requires_uploaded_artifact": true,
    "api_path": "/api/v1/artifacts/verify",
    "api_fields": [
      "release_id",
      "manifest_text",
      "release_index_text",
      "signature_base64",
      "key_id"
    ],
    "ui_fields": {
      "key_id": "Approved public-key ID",
      "manifest_file": "Embedded manifest \u00b7 original JSON file",
      "index_file": "Signed external release index \u00b7 original JSON file",
      "signature_file": "Detached signature \u00b7 binary .sig file"
    },
    "file_roles": {
      "manifest_file": "Exact pre-seal manifest, also embedded at /etc/sonic/smart-patch/manifest.json",
      "index_file": "Exact <image>.smart-patch.json",
      "signature_file": "Binary signature over exact index bytes, e.g. <image>.smart-patch.json.sig"
    },
    "key_example": {
      "key_id": "community-builder-2026",
      "server_public_key_path": "STATE_DIR/trusted-build-keys/community-builder-2026.pem",
      "public_key_must_be_provisioned": true
    },
    "bounds": {
      "manifest_bytes": 1048576,
      "index_bytes": 1048576,
      "signature_bytes_min": 1,
      "signature_bytes_max": 1024
    },
    "algorithms": [
      "RSA PKCS1v15 SHA256",
      "Ed25519"
    ],
    "verified_result_label": "Builder signature verified",
    "runtime_attestation": "not_available"
  },
  "external_agent": {
    "requires_provider_api_key": false,
    "web_provider_sso_button_exists": false,
    "creates_model_call_automatically": false,
    "submission_changes_applicability": false,
    "identity_claim_verified_by_provider": false,
    "session_minutes": 20,
    "max_tool_calls": 12,
    "max_context_chars": 16000,
    "max_response_chars": 48000,
    "max_bundle_chars": 32000,
    "max_fact_requests": 4,
    "ui_identity_defaults": [
      "snapshot_hash",
      "cve_id",
      "component_id",
      "scope_id"
    ],
    "recommended_action_values": [
      "collect_evidence",
      "manual_review",
      "maintenance_review",
      "no_change_pending_verification"
    ],
    "input_fields": [
      "Agent result JSON file \u00b7 optional",
      "Agent proposal JSON"
    ],
    "input_limit_note": "Response text <= session max_response_chars; file bytes <= 4 * this limit; submission schema applies",
    "generic_console_attaches_to_session": false
  },
  "review": {
    "role": "admin",
    "applicability_values": [
      "under_investigation",
      "affected",
      "fixed",
      "not_affected"
    ],
    "justification_min_characters": 20,
    "justification_max_characters": 4000,
    "requires_existing_evidence_ids": true,
    "https_reference_required_for": [
      "fixed",
      "not_affected"
    ],
    "vex_justification_required_for": [
      "not_affected"
    ],
    "vex_justification_values": [
      "component_not_present",
      "vulnerable_code_not_present",
      "vulnerable_code_not_in_execute_path",
      "vulnerable_code_cannot_be_controlled_by_adversary",
      "inline_mitigations_already_exist"
    ],
    "expires_days": 30
  },
  "maintenance": {
    "create_role": "operator_or_admin",
    "approve_stage_execute_role": "admin",
    "plan_hours": 24,
    "stages": [
      "Review target",
      "Approve",
      "Stage & check",
      "Execute",
      "Reassess"
    ],
    "target_validation_clears_approval": true,
    "ui_eligibility": {
      "approve": "unexpired draft with target_version",
      "validate": "unexpired draft/approved/validation_failed/target_validation_failed and options present",
      "stage": "unexpired approved + approved=true + staging_eligible=true",
      "execute": "unexpired staged + approved=true + execution_eligible=true + successful staging report"
    },
    "execution_confirmation": {
      "label": "Confirm target switch identity",
      "exact_value": "plan.device_id",
      "body_field": "confirmed_device_id"
    },
    "high_impact_note": "Container/core/kernel/FRR/OpenSSL plans may be manual runbooks; generic package plan does not execute image activation/reboot/routing restart"
  },
  "known_ui_caveats": [
    "Repository UI precheck permits 16 entries; backend limit is eight. Document/use eight.",
    "No dedicated release Sync button in current table; upload/configured source/API/background scheduling trigger sync.",
    "Global evidence console does not bind to the selected finding or external session.",
    "UI exposes fewer failed-plan recovery actions than the API; create/review a current plan when needed."
  ],
  "screenshot_rules": [
    "Never show a entered/revealed Smart Patch token or API key.",
    "Label mocked fixtures synthetic; do not label them deployed results.",
    "Use actual unavailable/unverified/under-investigation states when present.",
    "Root guide author captures and attaches screenshots; this reference does not run live actions."
  ],
